# docker-compose.dev.yml reads this file (renamed to .env.dev) to get
# deployment-site env vars that should NOT be committed: CPA URL, CPA keys,
# and any image-fallback secrets.
#
# Usage:
#   cp .env.dev.example .env.dev
#   # then fill in real values below
#   docker compose -f docker-compose.dev.yml up -d
#
# Empty / missing values are harmless:
#   - CPA_BASE_URL / CPA_MANAGEMENT_KEY are now OPTIONAL. You normally
#     configure the CPA connection ONCE in the panel's setup wizard;
#     manager-server then shares it with the in-container image-service
#     automatically (via /run/cpa_runtime.json). Only set them here if you
#     want to pin/override the CPA connection before the wizard runs, or
#     run image-service standalone without the panel. When set, env vars
#     take precedence over the wizard-provided value.
#   - If IMAGE_CPA_FALLBACK_ENABLED is false (default), no smart-router
#     fallback to CPA happens; CPA_IMAGE_API_KEY is unused.

# ---- CPA upstream (OPTIONAL override — normally set via panel wizard) ----
# Leave commented out to use whatever you enter in the setup wizard.
# Uncomment + fill only to pin the CPA connection from the environment.
#CPA_BASE_URL=https://your-cpa.example.com
# CPA Management Key — admin token for /v0/management/* endpoints.
# Same key the panel uses; visible only inside this container, never logged.
#CPA_MANAGEMENT_KEY=your-cpa-management-key-here

# ---- Smart image-router fallback (Phase 2.5) ----
# Off by default. Flip to "true" once CPA has Plus/Pro accounts that can
# call OpenAI's image API (DALL-E / gpt-image-1) and you've signed a
# client API key for those calls below.
IMAGE_CPA_FALLBACK_ENABLED=false

# CPA-issued client API key the smart router uses when retrying /v1/images/*
# against CPA. Different from CPA_MANAGEMENT_KEY: this one is what CPA
# hands to API consumers, not the admin token. Leave empty until you flip
# the flag above.
CPA_IMAGE_API_KEY=
